NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
REDIS_URL=
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
CHATGPT_REDIRECT_URIS=
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_SECONDS=3600
OAUTH_STATE_TTL_SECONDS=600
OAUTH_CODE_TTL_SECONDS=300
ALLOW_WRITES=false
BLOCK_DESTRUCTIVE_ACTIONS=true
REQUIRE_APPROVAL_FOR_WRITES=true
LOG_LEVEL=info
